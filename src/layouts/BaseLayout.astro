---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FloatingWhatsApp from '../components/FloatingWhatsApp.astro';
import PreviewDialogs from '../components/PreviewDialogs.astro';
import '../styles/global.css';
interface Props {
  title?: string;
  description?: string;
}
const { title = 'Terralma — Arquitetura que se sente.', description = 'Terralma. Arquitetura e interiores em Atibaia, São Paulo e região. Espaços que acolhem, funcionam e têm identidade.' } = Astro.props;
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <style is:inline>@layer base, components, home, about, services, projects;</style>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#F2E8DE" />
    <meta name="robots" content="index, follow" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="icon" type="image/png" href="/images/icons/favicon_terralma.png" />
    <link rel="preload" href="/fonts/PoiretOne-Regular.ttf" as="font" type="font/ttf" crossorigin />
    <link rel="preload" href="/fonts/Questrial-Regular.ttf" as="font" type="font/ttf" crossorigin />
  </head>
  <body id="inicio">
    <div class="site-scroll-progress" aria-hidden="true"><span class="site-scroll-progress-bar"></span></div>
    <a class="skip-link" href="#conteudo">Pular para o conteúdo</a>
    <Header />
    <main id="conteudo"><slot /></main>
    <Footer /><FloatingWhatsApp /><PreviewDialogs />
    <script>import '../scripts/site';</script>
  </body>
</html>
