---
import Brand from './Brand.astro';
import { navigation, instagramUrl, tiktokUrl, emailAddress, emailUrl } from '../data/site';
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-main">
      <Brand />
      <nav aria-label="Navegação do rodapé">
        {navigation.slice(1).map(item => <a href={item.href}>{item.label}</a>)}
        <a href="#contato">Vamos conversar</a>
      </nav>
      <div class="footer-social">
        <a href={instagramUrl} target="_blank" rel="noopener noreferrer">
          <svg aria-hidden="true" viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" clip-rule="evenodd" d="M12 18C15.3137 18 18 15.3137 18 12C18 8.68629 15.3137 6 12 6C8.68629 6 6 8.68629 6 12C6 15.3137 8.68629 18 12 18ZM12 16C14.2091 16 16 14.2091 16 12C16 9.79086 14.2091 8 12 8C9.79086 8 8 9.79086 8 12C8 14.2091 9.79086 16 12 16Z" /><path d="M18 5C18.5523 5 19 5.44772 19 6C19 6.55228 18.5523 7 18 7C17.4477 7 17 6.55228 17 6C17 5.44772 17.4477 5 18 5Z" /><path fill-rule="evenodd" clip-rule="evenodd" d="M1.65396 5.27613C1 6.55956 1 8.23971 1 11.6V12.4C1 15.7603 1 17.4404 1.65396 18.7239C2.2292 19.8529 3.14708 20.7708 4.27606 21.346C5.55953 22 7.23969 22 10.6 22H13.4C16.7603 22 18.4405 22 19.7239 21.346C20.8529 20.7708 21.7708 19.8529 22.346 18.7239C23 17.4405 23 15.7603 23 12.4V11.6C23 8.23969 23 6.55953 22.346 5.27606C21.7708 4.14708 20.8529 3.2292 19.7239 2.65396C18.4404 2 16.7603 2 13.4 2H10.6C7.23971 2 5.55956 2 4.27613 2.65396C3.14715 3.2292 2.2292 4.14715 1.65396 5.27613ZM13.4 4H10.6C8.88684 4 7.72232 4.00156 6.82296 4.07504C5.94694 4.14664 5.51233 4.27721 5.18404 4.44454C4.43139 4.82825 3.81998 5.43965 3.43627 6.19231C3.26894 6.5206 3.13838 6.9552 3.06677 7.83123C2.9933 8.73059 2.99173 9.8951 2.99173 11.6083V12.3917C2.99173 14.1049 2.9933 15.2694 3.06677 16.1688C3.13838 17.0448 3.26894 17.4794 3.43627 17.8077C3.81998 18.5603 4.43139 19.1718 5.18404 19.5555C5.51233 19.7228 5.94694 19.8534 6.82296 19.925C7.72232 19.9984 8.88684 20 10.6 20H13.4C15.1132 20 16.2777 19.9984 17.177 19.925C18.0531 19.8534 18.4877 19.7228 18.816 19.5555C19.5686 19.1718 20.18 18.5603 20.5637 17.8077C20.7311 17.4794 20.8616 17.0448 20.9332 16.1688C21.0067 15.2694 21.0083 14.1049 21.0083 12.3917V11.6083C21.0083 9.8951 21.0067 8.73059 20.9332 7.83123C20.8616 6.9552 20.7311 6.5206 20.5637 6.19231C20.18 5.43965 19.5686 4.82825 18.816 4.44454C18.4877 4.27721 18.0531 4.14664 17.177 4.07504C16.2777 4.00156 15.1132 4 13.4 4Z" /></svg>
