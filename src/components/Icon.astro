---
interface Props { name?: 'arrow' | 'arrow-up-right' | 'close' | 'menu' | 'whatsapp'; }
const { name = 'arrow' } = Astro.props;
---
<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {name === 'arrow' && <path d="M4 12h15m-6-6 6 6-6 6" />}
  {name === 'arrow-up-right' && <path d="M5 19 19 5M8 5h11v11" />}
  {name === 'close' && <path d="m6 6 12 12M6 18 18 6" />}
  {name === 'menu' && <path d="M3 8h18M3 16h18" />}
  {name === 'whatsapp' && <><path d="M20.5 11.8a8.5 8.5 0 0 1-12.6 7.5L3 21l1.6-4.9a8.5 8.5 0 1 1 15.9-4.3Z" /><path d="m8.2 7.4-1 .8c-.5 2.8 3.1 6.8 6.9 7.6l1.5-1.1-.1-1.4-2.2-1-.8 1c-1.4-.6-2.3-1.5-2.9-2.9l.9-.8-1-2.2Z" /></>}
</svg>
